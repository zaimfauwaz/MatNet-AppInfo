<Window x:Class="AppInfoGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppInfoGUI"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="MatNet AppInfo" Height="620" Width="900" MinHeight="560" MinWidth="800" Loaded="Window_Loaded">
    <Window.Resources>
        <!-- One row of "label: value", used by every tab that lists details -->
        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                         IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The file being checked, shown above every tab -->
        <TextBox x:Name="FilePathBox" IsReadOnly="True" Padding="4" Margin="8,8,8,0"/>

        <!-- The verdict: a headline, and under it the things worth a look -->
        <Border x:Name="VerdictBanner" Grid.Row="1" Background="LightGray"
                CornerRadius="4" Padding="12,8" Margin="8,8,8,0">
            <StackPanel>
                <TextBlock x:Name="VerdictText" Text="No file selected" Foreground="Black"
                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FindingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Dot}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Text}" Foreground="Black" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Margin="0,8,0,0">
            <TabItem x:Name="DetailsTab" Header="Application Details">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="272"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: icon and names -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <Border Width="256" Height="256" Background="White"
                                BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
                            <Image x:Name="AppIcon" Stretch="Uniform" StretchDirection="DownOnly"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock x:Name="IconInfoText" Text="No icon" Foreground="Gray"
                                   FontSize="12" Margin="0,4,0,12"/>
                        <TextBlock x:Name="TitleText" Text="No file selected" FontSize="18"
                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ProductText" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CompanyText" FontSize="14" Foreground="Gray"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Names come from the file itself and are not verified. See Digital Signatures."
                                   FontSize="11" Foreground="Gray" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Right: detail sections -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock Text="File" Style="{StaticResource SectionHeader}"/>
                            <ItemsControl x:Name="FileList" ItemTemplate="{StaticResource RowTemplate}"/>

                            <StackPanel x:Name="VersionSection">
                                <TextBlock Text="Version information" Style="{StaticResource SectionHeader}"/>
                                <ItemsControl x:Name="VersionList" ItemTemplate="{StaticResource RowTemplate}"/>
                            </StackPanel>

                            <StackPanel x:Name="LibrarySection" Visibility="Collapsed">
                                <TextBlock Text="Library" Style="{StaticResource SectionHeader}"/>
                                <ItemsControl x:Name="LibraryList" ItemTemplate="{StaticResource RowTemplate}"/>
                            </StackPanel>

                            <StackPanel x:Name="DriverSection" Visibility="Collapsed">
                                <TextBlock x:Name="DriverTitle" Style="{StaticResource SectionHeader}"/>
                                <ItemsControl x:Name="DriverList" ItemTemplate="{StaticResource RowTemplate}"/>
                            </StackPanel>

                            <TextBlock Text="Origin and location" Style="{StaticResource SectionHeader}"/>
                            <ItemsControl x:Name="OriginList" ItemTemplate="{StaticResource RowTemplate}"/>

                            <StackPanel x:Name="InstallerSection" Visibility="Collapsed">
                                <StackPanel x:Name="ProductSection">
                                    <TextBlock Text="Product" Style="{StaticResource SectionHeader}"/>
                                    <ItemsControl x:Name="ProductList" ItemTemplate="{StaticResource RowTemplate}"/>
                                </StackPanel>

                                <TextBlock Text="Package" Style="{StaticResource SectionHeader}"/>
                                <ItemsControl x:Name="PackageList" ItemTemplate="{StaticResource RowTemplate}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="PeTab" Header="PE Section">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,4,16,16">
                        <TextBlock x:Name="PeMessage" Foreground="Gray" TextWrapping="Wrap"/>

                        <TextBlock Text="Header" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="PeHeaderList" ItemTemplate="{StaticResource RowTemplate}"/>

                        <TextBlock Text="Security flags" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="PeSecurityList" ItemTemplate="{StaticResource RowTemplate}"/>

                        <TextBlock Text="Sections" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="PeSectionList" ItemTemplate="{StaticResource RowTemplate}"/>

                        <TextBlock Text="Manifest" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="PeManifestList" ItemTemplate="{StaticResource RowTemplate}"/>

                        <TextBlock Text=".NET" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="PeDotNetList" ItemTemplate="{StaticResource RowTemplate}"/>

                        <StackPanel x:Name="PeHashSection" Visibility="Collapsed">
                            <TextBlock Text="Authenticode hash" Style="{StaticResource SectionHeader}"/>
                            <ItemsControl x:Name="PeHashList" ItemTemplate="{StaticResource RowTemplate}"/>
                            <TextBlock Text="The hash a digital signature signs. It leaves out the signature itself, so it stays the same whether the file is signed or not. Signature checking is on the Digital Signatures tab."
                                       FontSize="11" Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="PackageTab" Header="Package Contents" Visibility="Collapsed">
                <Grid Margin="16,8,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PackageMessage" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <DataGrid x:Name="PackageGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="3*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="140"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem x:Name="OnPcTab" Header="On This PC">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,8,16,16">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RefreshOnPcButton" Content="Check again" Padding="12,4"
                                    Click="RefreshOnPc_Click"/>
                            <TextBlock x:Name="OnPcMessage" Foreground="Gray" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="Running now" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="OnPcRunningList" ItemTemplate="{StaticResource RowTemplate}"/>

                        <TextBlock Text="Programs &amp; Features" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="OnPcProgramList" ItemTemplate="{StaticResource RowTemplate}"/>

                        <TextBlock Text="Starts automatically" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="OnPcAutostartList" ItemTemplate="{StaticResource RowTemplate}"/>

                        <TextBlock Text="Firewall rules" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="OnPcFirewallList" ItemTemplate="{StaticResource RowTemplate}"/>

                        <TextBlock Text="This only looks at what Windows has on record. Some scheduled tasks can be read only when the app runs as administrator, and startup-folder shortcuts are not checked."
                                   FontSize="11" Foreground="Gray" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="InstallsTab" Header="Installer Contents" Visibility="Collapsed">
                <Grid Margin="16,8,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ContentsMessage" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <TabControl Grid.Row="1">
                        <TabItem x:Name="FilesSubTab" Header="Files">
                            <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Goes to" Binding="{Binding Folder}" Width="2*"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem x:Name="RegistrySubTab" Header="Registry">
                            <DataGrid x:Name="RegistryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Root" Binding="{Binding Root}" Width="160"/>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="2*"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem x:Name="ServicesSubTab" Header="Services">
                            <DataGrid x:Name="ServicesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*"/>
                                    <DataGridTextColumn Header="Starts" Binding="{Binding Start}" Width="110"/>
                                    <DataGridTextColumn Header="Runs as" Binding="{Binding Account}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem x:Name="ActionsSubTab" Header="Custom actions">
                            <DataGrid x:Name="ActionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Action" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="What it does" Binding="{Binding Kind}" Width="*"/>
                                    <DataGridTextColumn Header="Runs as" Binding="{Binding RunsAs}" Width="140"/>
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem x:Name="DependenciesTab" Header="Dependencies">
                <Grid Margin="16,8,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="RefreshDependenciesButton" Content="Refresh dependencies" Padding="12,4"
                                Click="RefreshDependencies_Click"/>
                        <TextBlock x:Name="DependencyMessage" Foreground="Gray" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="DependencyGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                              SelectionChanged="DependencyGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DLL" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Functions" Binding="{Binding FunctionCount}" Width="90"/>
                            <DataGridTextColumn Header="Found" Binding="{Binding Location}" Width="2*"/>
                            <DataGridTextColumn Header="Signed" Binding="{Binding Signed}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="FunctionTitle" Grid.Row="2" Text="Select a DLL to see its functions"
                               Style="{StaticResource SectionHeader}"/>
                    <ListBox x:Name="FunctionList" Grid.Row="3"/>

                    <TextBlock Grid.Row="4" Margin="0,8,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                               Text="Only the DLLs needed at start-up are listed. DLLs a program loads later are not shown. Signatures are checked only for DLLs in the same folder as the file."/>
                </Grid>
            </TabItem>
            <TabItem Header="Hashes">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,4,16,16">
                        <TextBlock x:Name="HashMessage" Foreground="Gray" TextWrapping="Wrap"/>

                        <TextBlock Text="File hashes" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="HashList" ItemTemplate="{StaticResource RowTemplate}"/>

                        <TextBlock Text="SHA-256 is the one to use. SHA-1 and MD5 are old and only kept because some sites and tools still list them."
                                   FontSize="11" Foreground="Gray" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Product Information (AI)">
                <Grid/>
            </TabItem>
            <TabItem Header="Digital Signatures">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SignatureList" Margin="16" ItemTemplate="{StaticResource RowTemplate}"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="VirusTotal">
                <Grid/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
